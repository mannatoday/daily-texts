PROVIDER=moravian_html
MORAVIAN_URL=https://www.moravian.org/the-daily-texts/
OUTPUT_DIR=./output
FORMATS=markdown,html,text,json
INCLUDE_SOURCE_LINK=true
BIBLE_VERSION=rcuv

# composite = try TRANSLATORS in order until one succeeds
TRANSLATOR=composite
TRANSLATORS=local,openai,anthropic,google,fallback

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional Google Cloud Translation API v2
GOOGLE_TRANSLATE_API_KEY=

# Local Ollama (recommended on 8GB RAM: qwen2.5:7b)
LOCAL_TRANSLATOR_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_TRANSLATOR_MODEL=qwen2.5:7b
LOCAL_TRANSLATOR_API_KEY=local

SCHEDULE_TIMEZONE=Asia/Taipei
SCHEDULE_HOUR=0
SCHEDULE_RETRY_HOURS=0,6

# Publishers: null | static_site | website (stub) | line (stub) | email (stub) | telegram (stub)
# Example: PUBLISHERS=static_site
PUBLISHERS=null
SITE_DIR=./site

HTTP_USER_AGENT=daily-texts-bot/1.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1.0
FHL_API_BASE=https://bible.fhl.net/json
