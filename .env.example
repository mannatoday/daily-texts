PROVIDER=moravian_html
MORAVIAN_URL=https://www.moravian.org/the-daily-texts/
OUTPUT_DIR=./output
FORMATS=markdown,html,text
INCLUDE_SOURCE_LINK=true
BIBLE_VERSION=rcuv

# composite = try TRANSLATORS in order until one succeeds
TRANSLATOR=composite
TRANSLATORS=local,openai,anthropic,fallback

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI-compatible local endpoint (Ollama / LM Studio). Leave empty to skip.
LOCAL_TRANSLATOR_BASE_URL=
LOCAL_TRANSLATOR_MODEL=llama3.2
LOCAL_TRANSLATOR_API_KEY=local

SCHEDULE_TIMEZONE=Asia/Taipei
SCHEDULE_HOUR=0
SCHEDULE_RETRY_HOURS=0,6
PUBLISHERS=null
HTTP_USER_AGENT=daily-texts-bot/1.0
FHL_API_BASE=https://bible.fhl.net/json
